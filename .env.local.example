# Instagram feed (home page): create a free JSON feed at https://behold.so
# connected to @marniblythespeaks, then paste its URL here and restart dev /
# set the same variable in Vercel project settings for deploys.
NEXT_PUBLIC_IG_FEED_URL=

# Booking form backend (/api/inquiry): create an API key in SMTP2GO
# (Sending > API Keys, with the Emails permission). Until this is set, the
# form falls back to opening a pre-filled email draft (mailto).
SMTP2GO_API_KEY=
# Where inquiries are delivered (default: marni@marniblythespeaks.com)
INQUIRY_TO=
# Sender. Its domain must be verified in SMTP2GO (Sending > Verified Senders).
# Default: Marni Blythe Speaks <marni@marniblythespeaks.com>
INQUIRY_FROM=
